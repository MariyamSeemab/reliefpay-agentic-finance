# ReliefPay API configuration. Copy to backend/.env (gitignored) and fill in.
# Empty values fall back to the defaults noted below.

# Port the API listens on (default 4000).
PORT=4000
# Secret used to sign login tokens. Required when NODE_ENV=production; random per start otherwise.
JWT_SECRET=
# SQLite file path (default backend/data/reliefpay.db).
DATABASE_PATH=

# PayPal sandbox REST app credentials from developer.paypal.com > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal REST base URL (sandbox).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Id of the webhook you created for https://<host>/api/webhooks/paypal (needed to verify webhooks).
PAYPAL_WEBHOOK_ID=
# Currency for donations and payouts.
PAYPAL_CURRENCY=USD

# Code an admin must enter to release a payout batch (batch locks after 5 wrong attempts).
PAYOUT_AUTH_CODE=
# Optional: send every payout item to this sandbox personal account email instead of the seeded addresses.
PAYOUT_RECEIVER_EMAIL=

# Groq API key from console.groq.com (enables the AI agent).
GROQ_API_KEY=
# Groq OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq model used by the agent.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: AG Studio licence key for /admin/analytics (sent only to signed-in admins/auditors because AG Studio validates it in the browser). Empty = watermark.
AG_STUDIO_LICENSE=
# Optional: set to on to enable the AG Studio AI assistant (POST /api/ai/studio/responses). Off by default.
AG_STUDIO_AI=
# AI provider for the AG Studio assistant only: groq (default, uses GROQ_API_KEY) or bedrock (Amazon Bedrock Converse API).
# Groq's on_demand tier (8,000 tokens per minute) is too small for AG Studio turns (~5k tokens each); bedrock avoids that.
AG_STUDIO_AI_PROVIDER=
# Bedrock model or inference profile id for the AG Studio assistant (default us.amazon.nova-2-lite-v1:0).
AG_STUDIO_BEDROCK_MODEL=
# AWS region for Bedrock (default us-east-1).
AWS_REGION=
# AWS credentials for Bedrock (see infra/reliefpay-bedrock.yaml for the least-privilege IAM user).
# Leave empty locally to use the AWS SDK default credential chain (e.g. your AWS CLI login).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
